# Notion integration
# 1. Create an internal integration at https://www.notion.so/profile/integrations
# 2. Copy the secret here.
# 3. In Notion, share the parent page containing the projects database with the
#    integration (Share → Invite → search for the integration name).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Master Projects database ID (32-char hex, with or without dashes).
# View the database as a full page; the ID is in the URL between the title
# slug and the `?v=` query string.
NOTION_PROJECTS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site URL (canonical, OG, sitemap).
SITE_URL=https://wrightindustries.com.au

# Resend (contact form). Leave empty until domain DKIM/SPF is set up; the
# /api/contact endpoint logs submissions when this is unset.
RESEND_API_KEY=

# Vercel Deploy Hook URL — POSTing to /api/revalidate calls this hook,
# which triggers a fresh build. Get the URL from Vercel project settings →
# Git → Deploy Hooks. Leave empty to disable the endpoint.
VERCEL_DEPLOY_HOOK=

# Optional shared secret for /api/revalidate. When set, callers must pass
# it via `?secret=...` or the X-Revalidate-Secret header.
REVALIDATE_SECRET=
