---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { source } from '~/lib/source'
import type { ProjectStatus } from '~/lib/sources/ContentSource'

const STATUS_LABEL: Record<ProjectStatus, string> = {
  active: 'ACTIVE',
  planning: 'PLANNING',
  future: 'FUTURE',
  'on-hold': 'ON HOLD',
  archived: 'ARCHIVED',
}

const STATUS_ORDER: Record<ProjectStatus, number> = {
  active: 0, planning: 1, future: 2, 'on-hold': 3, archived: 4,
}

const all = await source.listProjects()
const projects = [...all].sort((a, b) => {
  const so = STATUS_ORDER[a.status] - STATUS_ORDER[b.status]
  if (so !== 0) return so
  return (b.started ?? '').localeCompare(a.started ?? '')
})
---
<BaseLayout title="Projects" documentStripLeft="INDEX · PROJECTS">
  <div class="container page">
    <header class="page-header">
      <p class="page-kicker mono-chrome">INDEX</p>
      <h1 class="page-title">Projects</h1>
      <p class="page-lede">Active, planned, and archived work — each project a self-contained body of notes and releases.</p>
    </header>

    <hr class="page-divider" />

    <ul class="project-list">
      {projects.map((p) => (
        <li class="project-row">
          <div class="project-row-head">
            <h2 class="project-title">
              <a href={`/projects/${p.slug}`}>{p.title}</a>
            </h2>
            <span class={`status-chip mono-chrome status-${p.status}`}>{STATUS_LABEL[p.status]}</span>
          </div>
          {p.description && <p class="project-desc">{p.description}</p>}
          {p.started && (
            <p class="project-meta mono-chrome">STARTED {p.started}</p>
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { padding-block: var(--s-6) var(--s-8); }
  .page-header { max-width: var(--measure); }
  .page-kicker {
    color: var(--c-ink-muted);
    margin-bottom: var(--s-2);
  }
  .page-title {
    font-family: var(--font-display);
    font-size: var(--t-d1);
    line-height: var(--t-d1-lh);
    font-weight: var(--w-display-light);
    font-variation-settings: 'opsz' 60;
    letter-spacing: -0.01em;
  }
  .page-lede {
    margin-top: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-body-lg);
    line-height: 1.5;
    font-style: italic;
    color: var(--c-ink-muted);
    font-variation-settings: 'opsz' 24;
  }
  .page-divider {
    margin-block: var(--s-5);
    background: var(--c-rule);
  }

  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project-row {
    padding-block: var(--s-4);
    border-bottom: var(--rule-w) solid var(--c-rule);
  }
  .project-row:first-child { padding-top: 0; }
  .project-row:last-child { border-bottom: 0; }

  .project-row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-bottom: var(--s-2);
  }
  .project-title {
    font-family: var(--font-display);
    font-size: var(--t-d3);
    font-weight: var(--w-display);
    font-variation-settings: 'opsz' 32;
    margin: 0;
  }
  .project-title a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .project-title a:hover { color: var(--c-accent); }

  .status-chip {
    padding: 0.15rem var(--s-1);
    color: var(--c-ink-muted);
    border: var(--rule-w) solid var(--c-rule);
    flex-shrink: 0;
  }
  .status-active {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .project-desc {
    max-width: var(--measure);
    color: var(--c-ink);
    margin-bottom: var(--s-2);
  }
  .project-meta {
    color: var(--c-ink-muted);
  }
</style>
