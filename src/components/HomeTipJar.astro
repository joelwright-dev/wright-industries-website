---
// Small editorial coda under Active Projects on the home page. Intentionally
// unnumbered — primary sections carry §0X, this is a footnote-weight block.
---
<section class="tip-jar" aria-labelledby="tip-jar-h">
  <header class="tj-head">
    <h2 id="tip-jar-h" class="section-title">Tip jar</h2>
  </header>
  <hr />
  <p class="tj-body">
    If the workshop's notes have been useful to you, you can
    <a
      href="https://buymeacoffee.com/wrightindustries"
      rel="noopener noreferrer"
      target="_blank"
    >shout a coffee ↗</a>. Entirely optional, never expected.
  </p>
</section>

<style>
  .tip-jar { margin-top: var(--s-5); }
  .tj-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--s-2);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: var(--t-d3);
    font-weight: var(--w-display);
    font-variation-settings: 'opsz' 32;
    margin: 0;
  }
  hr {
    margin-block: var(--s-2) var(--s-3);
    background: var(--c-rule);
  }
  .tj-body {
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--c-ink-muted);
    margin: 0;
    max-width: var(--measure);
  }
  .tj-body a {
    color: var(--c-ink);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-w);
    text-underline-offset: 0.2em;
    transition: color var(--t-fast) var(--ease);
  }
  .tj-body a:hover, .tj-body a:focus-visible {
    color: var(--c-accent);
  }
</style>
