---
// Trigger for the site-wide search modal. Falls back to the /search page
// when JS is disabled or the modal isn't available.
---
<a class="search-trigger mono-chrome" href="/search" data-open-search aria-label="Open search">
  <span class="search-label">SEARCH</span>
  <span class="search-shortcut" aria-hidden="true">⌘K</span>
</a>

<script is:inline>
  document.querySelectorAll('[data-open-search]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      if (typeof window.__openSearchModal === 'function') {
        e.preventDefault()
        window.__openSearchModal()
      }
    })
  })
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    color: var(--c-ink-muted);
    text-decoration: none;
    border: var(--rule-w) solid var(--c-rule);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .search-trigger:hover, .search-trigger:focus-visible {
    color: var(--c-accent);
    border-color: var(--c-rule-strong);
  }
  .search-shortcut {
    padding: 0 var(--s-0);
    color: var(--c-ink-muted);
  }
  @media (max-width: 600px) {
    .search-label { display: none; }
  }
</style>
