---
// Search trigger — cosmetic-only for the placeholder homepage review. The
// real Cmd/Ctrl-K modal lands in the search task.
---
<a class="search-trigger mono-chrome" href="/search" aria-label="Search">
  <span class="search-label">SEARCH</span>
  <span class="search-shortcut" aria-hidden="true">⌘K</span>
</a>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-2);
    color: var(--c-ink-muted);
    text-decoration: none;
    border: var(--rule-w) solid var(--c-rule);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .search-trigger:hover {
    color: var(--c-accent);
    border-color: var(--c-rule-strong);
  }
  .search-shortcut {
    padding: 0 var(--s-0);
    color: var(--c-ink-muted);
  }
  @media (max-width: 600px) {
    .search-label { display: none; }
  }
</style>
