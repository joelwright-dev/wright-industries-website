---
import type { ProjectMeta, ProjectStatus } from '~/lib/sources/ContentSource'

interface Props {
  projects: readonly ProjectMeta[]
  sectionNumber?: string
}

const { projects, sectionNumber = '§02' } = Astro.props

const STATUS_LABEL: Record<ProjectStatus, string> = {
  active: 'ACTIVE',
  planning: 'PLANNING',
  future: 'FUTURE',
  'on-hold': 'ON HOLD',
  archived: 'ARCHIVED',
}
---
<section class="active-projects" aria-labelledby="active-h">
  <header class="ap-head">
    <h2 id="active-h" class="section-title">Active projects</h2>
    <span class="section-num mono-chrome">{sectionNumber}</span>
  </header>
  <hr />
  <ul class="project-list">
    {projects.map((p) => (
      <li class="project-row">
        <a href={`/projects/${p.slug}`} class="project-link">
          <span class="project-arrow" aria-hidden="true">→</span>
          <span class="project-name">{p.title}</span>
        </a>
        <span class={`status-chip mono-chrome status-${p.status}`}>
          {STATUS_LABEL[p.status]}
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .ap-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--s-2);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: var(--t-d3);
    font-weight: var(--w-display);
    font-variation-settings: 'opsz' 32;
    margin: 0;
  }
  .section-num {
    color: var(--c-ink-muted);
  }
  hr {
    margin-block: var(--s-2) var(--s-3);
    background: var(--c-rule);
  }
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-bottom: var(--rule-w) solid var(--c-rule);
  }
  .project-row:last-child { border-bottom: 0; }

  .project-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: var(--t-body-lg);
    font-weight: var(--w-display);
    font-variation-settings: 'opsz' 20;
  }
  .project-link:hover, .project-link:focus-visible {
    color: var(--c-accent);
  }
  .project-arrow {
    color: var(--c-ink-muted);
    font-family: var(--font-mono);
    font-weight: var(--w-mono);
  }

  .status-chip {
    flex-shrink: 0;
    padding: 0.15rem var(--s-1);
    color: var(--c-ink-muted);
    border: var(--rule-w) solid var(--c-rule);
    letter-spacing: var(--t-mono-letter);
  }
  .status-active {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }
</style>
