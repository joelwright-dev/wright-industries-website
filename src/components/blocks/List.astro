---
import type { ListBlock } from '~/lib/content-blocks'
import { inlineHTML } from '~/lib/inline'
import Blocks from './Blocks.astro'

interface Props { block: ListBlock }
const { block } = Astro.props

const Tag = block.ordered ? 'ol' : 'ul'
---
<Tag>
  {block.items.map((item) => (
    <li>
      <span set:html={inlineHTML(item.runs)} />
      {item.children.length > 0 && <Blocks blocks={item.children} />}
    </li>
  ))}
</Tag>
