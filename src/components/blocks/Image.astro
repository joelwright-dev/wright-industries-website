---
import type { ImageBlock } from '~/lib/content-blocks'
import { inlineHTML, inlineText } from '~/lib/inline'

interface Props { block: ImageBlock }
const { block } = Astro.props

const captionText = inlineText(block.caption)
const captionHTML = inlineHTML(block.caption)
// Caption may start with "Figure N:" — when figureNumber is present, we
// render it as a structured "Fig. N · …" prefix in mono, then the rest of
// the caption text in mono as well. The figureNumber comes from the
// numberFigures pass in blocks.ts.
const figLabel = block.figureNumber ? `Fig. ${block.figureNumber}` : null
const alt = block.alt.length > 0 ? block.alt : captionText
// Caption passed to the lightbox combines the figure label with the
// caption text so the preview reads the same as the in-page figcaption.
const zoomCaption = [figLabel, captionText].filter(Boolean).join(' · ')
---
<figure class="figure">
  <a
    class="figure-link"
    href={block.src}
    data-zoom
    data-zoom-alt={alt}
    data-zoom-caption={zoomCaption}
    aria-label={alt ? `View larger: ${alt}` : 'View larger image'}
  >
    <img src={block.src} alt={alt} loading="lazy" decoding="async" />
  </a>
  {(figLabel || captionHTML.length > 0) && (
    <figcaption>
      {figLabel && <span class="fig-label">{figLabel}</span>}
      {figLabel && captionHTML.length > 0 && <span class="fig-sep" aria-hidden="true"> · </span>}
      <span set:html={captionHTML} />
    </figcaption>
  )}
</figure>

<style>
  .figure { margin-block: var(--s-5); }
  .figure-link {
    display: block;
    cursor: zoom-in;
    text-decoration: none;
    border: var(--rule-w) solid var(--c-rule);
    transition: border-color var(--t-fast) var(--ease);
  }
  .figure-link:hover,
  .figure-link:focus-visible {
    border-color: var(--c-rule-strong);
  }
  .figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .fig-label {
    font-weight: var(--w-mono-strong);
    color: var(--c-ink-muted);
  }
  .fig-sep { color: var(--c-rule-strong); }
</style>
