---
import type { BookmarkBlock } from '~/lib/content-blocks'
import { inlineHTML, inlineText } from '~/lib/inline'

interface Props { block: BookmarkBlock }
const { block } = Astro.props

let hostname = ''
try {
  hostname = new URL(block.url).hostname.replace(/^www\./, '')
} catch (e) {
  void e
}
const captionText = inlineText(block.caption)
const captionHTML = inlineHTML(block.caption)
---
<a class="bookmark" href={block.url} rel="noopener external">
  <span class="bookmark-host mono-margin">{hostname || 'LINK'}</span>
  <span class="bookmark-title">{captionText || block.url}</span>
  {captionHTML.length > 0 && captionText !== block.url && (
    <span class="bookmark-caption" set:html={captionHTML} />
  )}
</a>

<style>
  .bookmark {
    display: block;
    padding: var(--s-3);
    border: var(--rule-w) solid var(--c-rule);
    background: var(--c-bg-elev);
    text-decoration: none;
    color: var(--c-ink);
    margin-block: var(--s-3);
    transition: border-color var(--t-fast) var(--ease);
  }
  .bookmark:hover {
    border-color: var(--c-rule-strong);
    color: var(--c-accent);
  }
  .bookmark-host {
    display: block;
    color: var(--c-ink-muted);
    margin-bottom: var(--s-1);
  }
  .bookmark-title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-body);
    font-weight: var(--w-display);
    font-variation-settings: 'opsz' 16;
  }
</style>
