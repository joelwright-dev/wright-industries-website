---
import SearchTrigger from './SearchTrigger.astro'
import ThemeToggle from './ThemeToggle.astro'
import { SITE } from '~/config/site'

interface Props {
  /** Render the wordmark large (masthead on home/about) or compact (everywhere else). */
  large?: boolean
}

const { large = false } = Astro.props
---
<header class="masthead container">
  <div class={`mast-row ${large ? 'mast-row--large' : ''}`}>
    <a href="/" class="wordmark" aria-label={SITE.title}>
      {large
        ? <span class="wordmark-large">{SITE.title}</span>
        : <span class="wordmark-compact mono-chrome">{SITE.title}</span>}
    </a>
    <nav class="mast-nav" aria-label="Primary">
      <SearchTrigger />
      <ThemeToggle />
    </nav>
  </div>
  {large && (
    <p class="mast-tagline">{SITE.tagline}</p>
  )}
</header>

<style>
  .masthead {
    padding-block: var(--s-4) var(--s-3);
  }
  .mast-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
  }
  .mast-row--large {
    align-items: flex-start;
    padding-top: var(--s-5);
  }
  .wordmark { text-decoration: none; color: var(--c-ink); }
  .wordmark:hover { color: var(--c-ink); }
  .wordmark-large {
    font-family: var(--font-display);
    font-size: var(--t-d1);
    line-height: var(--t-d1-lh);
    font-weight: var(--w-display-light);
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    display: block;
  }
  .wordmark-compact {
    color: var(--c-ink);
    letter-spacing: var(--t-mono-letter);
  }
  .mast-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .mast-tagline {
    margin-top: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-body-lg);
    line-height: 1.4;
    max-width: var(--measure);
    color: var(--c-ink-muted);
    font-style: italic;
    font-variation-settings: 'opsz' 24;
  }
  @media (max-width: 600px) {
    .mast-row--large { flex-direction: column; align-items: flex-start; }
    .mast-row--large .mast-nav { align-self: flex-end; margin-top: calc(var(--s-4) * -1); }
  }
</style>
