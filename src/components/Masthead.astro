---
import SearchTrigger from './SearchTrigger.astro'
import ThemeToggle from './ThemeToggle.astro'
import { SITE } from '~/config/site'

interface Props {
  /** Render the wordmark large (masthead on home/about) or compact (everywhere else). */
  large?: boolean
}

const { large = false } = Astro.props
---
<header class={`masthead container ${large ? 'is-large' : ''}`}>
  <div class="mast-row">
    <a href="/" class="wordmark" aria-label={SITE.title}>
      <span class={`wordmark-text ${large ? 'is-large' : 'is-compact'}`}>
        {SITE.title}
      </span>
    </a>
    <nav class="mast-nav" aria-label="Primary">
      <SearchTrigger />
      <ThemeToggle />
    </nav>
  </div>
  {large && (
    <p class="mast-tagline">{SITE.tagline}</p>
  )}
</header>

<style>
  .masthead {
    padding-block: var(--s-4) var(--s-3);
  }
  .mast-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }
  .is-large .mast-row {
    align-items: flex-start;
    padding-top: var(--s-5);
  }

  .wordmark {
    text-decoration: none;
    color: var(--c-ink);
    min-width: 0;
  }
  .wordmark:hover { color: var(--c-ink); }

  /* Compact form — used on every non-home page and on every page under
   * 640px wide. Mono uppercase to match the document-strip language. */
  .wordmark-text {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-mono-chrome);
    font-weight: var(--w-mono);
    line-height: 1.1;
    letter-spacing: var(--t-mono-letter);
    text-transform: uppercase;
    color: var(--c-ink);
  }

  /* Large form — kicks in on home/about pages from 640px up. */
  @media (min-width: 640px) {
    .wordmark-text.is-large {
      font-family: var(--font-display);
      font-size: var(--t-d1);
      line-height: var(--t-d1-lh);
      font-weight: var(--w-display-light);
      font-variation-settings: 'opsz' 72;
      letter-spacing: -0.015em;
      text-transform: none;
    }
  }

  .mast-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }

  /* Tagline drops below the row, never crowding it. */
  .mast-tagline {
    margin-top: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-body);
    line-height: 1.45;
    max-width: var(--measure);
    color: var(--c-ink-muted);
    font-style: italic;
    font-variation-settings: 'opsz' 20;
  }
  @media (min-width: 640px) {
    .mast-tagline {
      font-size: var(--t-body-lg);
      font-variation-settings: 'opsz' 24;
    }
  }
</style>
